      <div style="background: #0d47a1; padding: 10px 15px; border-radius: 4px;">Inicio</div>
      <div style="background: #6a1b9a; padding: 10px 15px; border-radius: 4px;">Ubicaciones</div>
      <div style="background: #e65100; padding: 10px 15px; border-radius: 4px;">Denuncias</div>
      <div style="background: #2e7d32; padding: 10px 15px; border-radius: 4px;">Verificar productos</div>
      <div style="background: #b71c1c; padding: 10px 15px; border-radius: 4px;">Comparar precios</div>
    </nav>

    <!-- ISLA DE REACT CARGADA DINÁMICAMENTE -->
    <ModuloVerificacion client:load />

