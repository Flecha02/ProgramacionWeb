---
// src/pages/verificacion.astro
import ModuloVerificacion from '../components/ModuloVerificacion.jsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Denuncias - Sistema de Trazabilidad GT</title>
  </head>
  <body style="background-color: #f4f6f8; margin: 0; padding: 20px; font-family: system-ui, sans-serif;">
    
    <!-- Barra de Navegación con el botón conectado -->
    <nav style="display: flex; gap: 10px; margin-bottom: 25px; font-weight: bold; color: white;">
      <div style="background: #0d47a1; padding: 10px 15px; border-radius: 4px; cursor: pointer;" onclick="window.location.href='/'">Inicio</div>
      <div style="background: #6a1b9a; padding: 10px 15px; border-radius: 4px; cursor: pointer;" onclick="window.location.href='/ubicaciones'">Ubicaciones</div>
      <div style="background: #e65100; padding: 10px 15px; border-radius: 4px; cursor: pointer;" onclick="window.location.href='/denuncias'">Denuncias</div>
      <div style="background: #2e7d32; padding: 10px 15px; border-radius: 4px; cursor: pointer;" onclick="window.location.href='/verificacion'">Verificar productos</div>
      <div style="background: #b71c1c; padding: 10px 15px; border-radius: 4px; cursor: pointer;" onclick="window.location.href='/comparar'">Comparar precios</div>
    </nav>

    <!-- CARGA DE TU ISLA DE REACT -->
    <main style="max-width: 800px; margin: 0 auto; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
      <ModuloVerificacion client:load />
    </main>

  </body>
</html>